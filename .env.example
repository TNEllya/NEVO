# ============================================================
# NEVO Server Configuration
# ============================================================
# Copy this file to .env and customize for your deployment.
#   cp .env.example .env
#
# Then run:
#   docker compose up -d --build
# ============================================================

# --- Docker Registry (for docker-compose.pull.yml) ---
# GitHub Container Registry repository owner (your GitHub username or org)
NEVO_REPO_OWNER=your-username
# Image tag to pull (latest, v0.1.0, sha-abc1234, etc.)
NEVO_IMAGE_TAG=latest

# --- Server Identity ---
NEVO_SERVER_NAME=NEVO Server

# --- Port Configuration ---
# Client control / signalling TCP port
NEVO_TCP_PORT=24430
# Voice media UDP port
NEVO_UDP_PORT=24431
# Video/screen-share media UDP port (auto-assigned as udp_port + 1)
NEVO_VIDEO_UDP_PORT=24432
# Management JSON-over-TCP port (ControlServer)
NEVO_CONTROL_PORT=24433
# Web management UI port
NEVO_WEB_PORT=8090

# --- Server Capacity ---
NEVO_MAX_USERS=100
NEVO_THREADS=4

# --- Logging ---
# trace/debug/info/warn/error
NEVO_LOG_LEVEL=info

# --- Timezone ---
TZ=Asia/Shanghai

# --- Resource Limits ---
NEVO_CPU_LIMIT=2
NEVO_MEMORY_LIMIT=512M

# --- GitHub Container Registry Authentication (optional) ---
# For private repositories, set these to pull images from GHCR.
# For public repos, leave empty (anonymous pull).
# GITHUB_USER=your-github-username
# GITHUB_TOKEN=ghp_xxxxxxxxxxxx